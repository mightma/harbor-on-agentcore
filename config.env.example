# Every machine- and account-specific value the four parts need. Copy to
# config.env, edit, and each part's scripts will source it:
#
#   cp config.env.example config.env && $EDITOR config.env
#
# Nothing else in this kit hardcodes an account id, a role ARN or an absolute
# path, so this file is the whole surface you have to change.

# ---------------------------------------------------------------------------
# AWS
# ---------------------------------------------------------------------------
export AWS_REGION=us-west-2
export AWS_DEFAULT_REGION=us-west-2

# Execution role assumed by every AgentCore Runtime session. It needs to pull
# from the two ECR repositories below and write CloudWatch logs.
#
# Give it bedrock:InvokeModel ONLY if you intend the sandbox itself to call a
# model -- part 3's Bedrock path with an *installed* agent (claude-code) needs
# it, the vLLM path and part 4 do not. Anything running in the sandbox can read
# these credentials off the microVM's IMDS, so treat this as the blast radius:
# the agent under test, and any task-supplied script, gets whatever you grant.
export ACR_EXECUTION_ROLE_ARN=arn:aws:iam::CHANGEME:role/AmazonBedrockAgentCoreSDKRuntime-us-west-2-xxxxxxxxxx

# ECR repository Harbor pushes the sandbox-wrapped task images to. Created on
# first use if absent.
export HARBOR_AGENTCORE_ECR_REPOSITORY=harbor-agentcore

# ECR repository for the raw and prepared SWE-smith arm64 images built in part 1.
export SWESMITH_ECR_REPOSITORY=swesmith-arm64

# Registry host that unqualified image references in the committed manifests are
# resolved against. Leave unset and it is derived from the caller's identity
# (`aws sts get-caller-identity` + AWS_REGION), which is what you want when the
# images live in your own account. Set it to pull from someone else's registry, or
# to avoid the STS call.
# export ECR_REGISTRY=123456789012.dkr.ecr.us-west-2.amazonaws.com

# ---------------------------------------------------------------------------
# Where things live
# ---------------------------------------------------------------------------
# Scratch: image build roots, generated task directories, uv cache, model
# weights, job output. Wants hundreds of GB and fast local disk.
#
# If this is instance-local NVMe, assume it can vanish on a stop/start -- it did
# twice while this kit was being built. Keep nothing here you cannot regenerate,
# and see part1's README on which artifacts are the durable ones.
export KIT_WORK_DIR=/opt/dlami/nvme/harbor-on-agentcore

# Durable: manifests and instance lists that are expensive to rediscover. Put
# this on network storage (EFS/NFS) or in git, not on scratch.
export KIT_STATE_DIR="$KIT_WORK_DIR/state"

export HARBOR_DATASETS="$KIT_WORK_DIR/datasets"
export HARBOR_JOBS="$KIT_WORK_DIR/jobs"

export UV_CACHE_DIR="$KIT_WORK_DIR/uv-cache"
export HF_HOME="$KIT_WORK_DIR/hf"
export HF_HUB_ENABLE_HF_TRANSFER=1
export TMPDIR="$KIT_WORK_DIR/tmp"

# ---------------------------------------------------------------------------
# The Harbor build under test
# ---------------------------------------------------------------------------
# Parts 3 and 4 install Harbor from this ref as a package. It carries five
# changes that are not upstream yet; see the top-level README for what they are
# and which are in review.
export HARBOR_GIT_REF=git+https://github.com/mightma/harbor@acr-kit

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Part 3 evaluates two policies. The Bedrock one is a cross-region inference
# profile id -- `aws bedrock list-inference-profiles` shows what your account
# has ACTIVE in this region.
export EVAL_BEDROCK_MODEL=us.anthropic.claude-sonnet-5

# The open-weights policy, served locally with vLLM in part 3 and trained in
# part 4. Only Qwen3.5-4B has measured numbers in this kit; see the top-level
# README's "measured vs untested" table before quoting anything for 9B.
export POLICY_MODEL=Qwen/Qwen3.5-9B

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Reporting. Leave WANDB_API_KEY unset to keep results on disk only; part 4
# refuses to start with LOGGER=wandb and no key rather than losing a long run's
# metrics.
export WANDB_PROJECT=harbor-on-agentcore
# export WANDB_API_KEY=

mkdir -p "$KIT_WORK_DIR" "$KIT_STATE_DIR" "$HARBOR_DATASETS" "$HARBOR_JOBS" \
         "$UV_CACHE_DIR" "$HF_HOME" "$TMPDIR"
